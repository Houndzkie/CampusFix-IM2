# Copy this file to ".env" and fill in the real values from your Supabase project.
# By default, the project uses local SQLite for simpler classroom development.
# Set USE_SUPABASE_DB=true only when you intentionally want PostgreSQL.
# Dashboard -> Connect -> Session pooler (recommended for classroom/IPv4 networks).
USE_SUPABASE_DB=false
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:YOUR_PASSWORD@[POOLER-HOST]:5432/postgres
